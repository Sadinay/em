+def prune_success(folder, expected):
+    """Validate first, commit a hash-linked receipt, then remove only regenerable work files."""
+    folder = Path(folder).resolve()
+    require(folder.is_relative_to((HERE / "femm_runs").resolve()), "Cleanup outside pilot run directory")
+    result = validate_success(folder, expected)
+    parents = [folder] + [p for p in folder.glob("attempt_*") if p.is_dir() and p.name[8:].isdigit()]
+    paths = [parent / f"model.{ext}" for parent in parents
+             for ext in ("fem", "ans", "node", "ele", "edge", "poly", "pbc")]
+    for path in paths:
+        require(path.resolve().is_relative_to(folder), f"Cleanup target leaves angle directory: {path}")
+    state = read(folder / "state.json")
+    receipt = folder / "artifact_retention.json"
+    save(receipt, artifact_receipt(result, state["result_sha256"]))
+    state["artifact_retention_sha256"] = sha(receipt)
+    save(folder / "state.json", state)
+    # The receipt is durable before deletion, so an interrupted cleanup can resume.
+    for path in paths:
+        path.unlink(missing_ok=True)
+    return result
+
