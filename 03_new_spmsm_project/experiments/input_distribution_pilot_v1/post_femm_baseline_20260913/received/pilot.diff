+def retry_file_access(operation, path):
+    """Bounded retries for transient Windows file locks; never truncate the live result."""
+    for attempt in range(12):
+        try:
+            return operation()
+        except PermissionError as exc:
+            if attempt == 11:
+                raise PermissionError(exc.errno, f"File access failed after 12 attempts: {path}; {exc}") from exc
+            time.sleep(min(0.05 * 2**attempt, 1.0))
+
