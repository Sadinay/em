# Auto detect text files and perform LF normalization
* text=auto

# Keep scientific inputs byte-exact for the recorded SHA-256 checks.
*.[fF][eE][mM] -text
*.mat -text
*.npz -text
*.npy -text
*.sqlite -text
*.pt -text
*.zip -text

# The frozen 03 physical-config hash must survive Windows Git checkouts.
03_new_spmsm_project/femm_zone/femm_config.py text eol=lf
